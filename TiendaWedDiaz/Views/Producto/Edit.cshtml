@model TiendaWedDiaz.Models.Producto

<h2>Editar Producto</h2>

< from asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label>Nombre</label>
        <input asp-for="Nombre" class="form-control" />
    </div>

    <div class="form-group">
        <label>Precio</label>
        <input asp-for="Precio" class="form-control" />
    </div>

    <div class="form-group">
        <label>Stock</label>
        <input asp-for="Stock" class="form-control" />
    </div>

    <div class="form-group">
        <label>Categoría</label>
        <input asp-for="CategoriaId" class="form-control" />
    </div>

    <hr>
    <button class="btn btn-primary">Actualizar</button>
    <div class="mb-3">
    <label asp-for="CategoriaId" class="form-label"></label>
    <select asp-for="CategoriaId" class="form-select" asp-items="(SelectList)ViewBag.Categorias">
        <option value="">-- Seleccione una categoría --</option>
    </select>
    <span asp-validation-for="CategoriaId" class="text-danger"></span>
</div>
</from>