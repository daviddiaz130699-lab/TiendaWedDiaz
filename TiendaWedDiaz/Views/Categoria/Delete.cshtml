@model TiendaWedDiaz.Models.Usuario
@{
    ViewData["Title"] = "Eliminar Categoria";
}

<h1>Eliminar usuario</h1>
<h4 class="text-danger">¿Seguro que deseas eliminar este usuario?</h4>
<dl class="row">
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Nombre</dd>
    <dt class="col-sm-2">Correo</dt>
    <dd class="col-sm-10">@Model.Correo</dd>
    <dt class="col-sm-2">Rol</dt>
    <dd class="col-sm-10">@Model.Rol</dd>
    <dt class="col-sm-2">Celular</dt>
    <dd class="col-sm-10">@Model.Celular</dd>
</dl>
<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>