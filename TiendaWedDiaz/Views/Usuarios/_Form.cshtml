@model TiendaWedDiaz.Models.Usuario

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="Nombre" class="form-label"></label>
    <input asp-for="Nombre" class="form-control" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Correo" class="form-label"></label>
    <input asp-for="Correo" class="form-control" />
    <span asp-validation-for="Correo" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Rol" class="form-label"></label>
    <select asp-for="Rol" class="form-select" asp-items="(SelectList)ViewBag.Roles">
        <option value="">-- Seleccione un rol --</option>
    </select>
    <span asp-validation-for="Rol" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Celular" class="form-label"></label>
    <input asp-for="Celular" class="form-control" maxlength="10" placeholder="3001234567" />
    <span asp-validation-for="Celular" class="text-danger"></span>
</div>